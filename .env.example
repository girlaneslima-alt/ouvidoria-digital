# ── Banco de Dados (Neon — https://neon.tech) ─────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host/ouvidoria?sslmode=require

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
AUTH_SECRET=                    # gere com: openssl rand -base64 32

# GOV.BR usa Google OAuth — configure em console.cloud.google.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic link via Resend (opcional, para recuperação de senha)
AUTH_RESEND_KEY=                # Resend API Key

# ── Resend (e-mails transacionais) ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Ouvidoria Digital <noreply@ouvidoria.gov.br>

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Nota: este projeto NÃO usa Stripe (serviço público gratuito) ─────────────
